# Local development only. Copy it to .env (git-ignored) and change the passwords and the token:
#   cp .env.example .env
# Compose reads it for Postgres; the backend reads it from the shell (README, "Running locally").

POSTGRES_PASSWORD=change_me
APP_DB_PASSWORD=change_me_too
DB_PORT=5433

# The owner runs the migrations and grants the app's role what it needs; the app connects as
# that role, which owns nothing. The same two roles as in production.
MIGRATION_DATABASE_URL=postgresql://cuanto_cuesta:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/cuanto_cuesta
DATABASE_URL=postgresql://cuanto_cuesta_app:${APP_DB_PASSWORD}@localhost:${DB_PORT}/cuanto_cuesta
APP_DB_USER=cuanto_cuesta_app

# At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=change_me_to_a_random_token_of_32_characters_or_more
